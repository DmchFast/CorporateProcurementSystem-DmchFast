<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team.corporate.fx.controller.LoginController"
           stylesheets="@/css/styles.css"
           styleClass="login-root"
           alignment="CENTER">

    <VBox styleClass="login-card" alignment="TOP_CENTER"
          maxHeight="-Infinity" maxWidth="420">

        <!-- Логотип -->
        <StackPane fx:id="logoPlaceholder" styleClass="login-logo"/>

        <!-- Заголовок и подзаголовок -->
        <Label text="АРГУС" styleClass="login-title"
               maxWidth="Infinity" alignment="CENTER"/>
        <Label text="Корпоративная система управления закупками"
               styleClass="login-subtitle"
               maxWidth="Infinity"/>

        <!-- Имя -->
        <VBox styleClass="login-form-group" maxWidth="Infinity">
            <HBox styleClass="login-form-label-row">
                <Label text="Имя пользователя" styleClass="login-form-label"/>
                <Label text="*" styleClass="login-form-required"/>
            </HBox>
            <TextField fx:id="usernameField" styleClass="login-input"
                       promptText="Введите имя пользователя"/>
            <Label fx:id="errorLabel"
                   text="Пользователь не найден"
                   styleClass="login-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Кнопка входа -->
        <Button fx:id="loginBtn" text="Войти в систему"
                styleClass="btn, btn-primary"
                maxWidth="Infinity"/>

    </VBox>
</StackPane>