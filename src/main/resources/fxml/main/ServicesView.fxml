<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team.corporate.fx.controller.ServicesController"
            fitToWidth="true"
            styleClass="page-scroll">

    <VBox styleClass="page-content" spacing="24">

        <Label fx:id="pageTitleLabel" text="Сервисы" styleClass="page-title"/>

        <GridPane fx:id="servicesGrid" hgap="20" vgap="20">

            <!-- Каталог товаров -->
            <VBox fx:id="catalogCard" styleClass="service-card, card-purple"
                  GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label fx:id="catalogTitleLabel" text="Каталог товаров" styleClass="service-card-title"/>
                <Label fx:id="catalogSubtitleLabel" text="Управление товарами и ценами" styleClass="service-card-subtitle"/>
            </VBox>

            <!-- Заказы -->
            <VBox fx:id="ordersCard" styleClass="service-card, card-orange"
                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label fx:id="ordersTitleLabel" text="Заказы" styleClass="service-card-title"/>
                <Label fx:id="ordersSubtitleLabel" text="Создание и отслеживание заказов" styleClass="service-card-subtitle"/>
            </VBox>

            <!-- Категории -->
            <VBox fx:id="categoriesCard" styleClass="service-card, card-teal"
                  GridPane.rowIndex="0" GridPane.columnIndex="2">
                <Label fx:id="categoriesTitleLabel" text="Категории" styleClass="service-card-title"/>
                <Label fx:id="categoriesSubtitleLabel" text="Категории товаров" styleClass="service-card-subtitle"/>
            </VBox>

            <!-- Склады и остатки -->
            <VBox fx:id="warehousesCard" styleClass="service-card, card-green"
                  GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label fx:id="warehousesTitleLabel" text="Склады и остатки" styleClass="service-card-title"/>
                <Label fx:id="warehousesSubtitleLabel" text="Управление складскими запасами" styleClass="service-card-subtitle"/>
            </VBox>

            <!-- Статистика -->
            <VBox fx:id="statisticsCard" styleClass="service-card, card-indigo"
                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label fx:id="statisticsTitleLabel" text="Статистика" styleClass="service-card-title"/>
                <Label fx:id="statisticsSubtitleLabel" text="Аналитика и показатели системы" styleClass="service-card-subtitle"/>
            </VBox>

            <!-- Экспорт данных -->
            <VBox fx:id="exportCard" styleClass="service-card, card-cyan"
                  GridPane.rowIndex="1" GridPane.columnIndex="2">
                <Label fx:id="exportTitleLabel" text="Экспорт данных" styleClass="service-card-title"/>
                <Label fx:id="exportSubtitleLabel" text="Выгрузка в CSV" styleClass="service-card-subtitle"/>
            </VBox>

            <!-- Пользователи -->
            <VBox fx:id="usersCard" styleClass="service-card, card-red"
                  GridPane.rowIndex="2" GridPane.columnIndex="0">
                <Label fx:id="usersTitleLabel" text="Пользователи" styleClass="service-card-title"/>
                <Label fx:id="usersSubtitleLabel" text="Управление пользователями" styleClass="service-card-subtitle"/>
            </VBox>

        </GridPane>
    </VBox>
</ScrollPane>